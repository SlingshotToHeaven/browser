+    private void refreshMediaForActiveTab(TabModel active) {
+        PrivacyWebView webView = active.getWebView();
+        TabNavigation.Page page = active.navigation.page();
+        if (!currentPage(active, webView, page, true) || !allowsPageScripts(active, webView) || rejectPrivateDownloads(active)) return;
+        String url = active.getUrl();
+        Toast.makeText(this, "Refreshing media streams...", Toast.LENGTH_SHORT).show();
+        if (active.messages != null) active.messages.evaluate(PrivacyWebViewClient.VIDEO_SNIFFER_JS);
+        Runnable completed = () -> runOnUiThread(() -> {
+            if (!currentPage(active, webView, page, true)) return;
+            int count = MediaSniffer.getMediaForTab(page.key).size();
+            if (count > 0) onFloatingDownloadFabClicked();
+            else Toast.makeText(this, "No video streams detected", Toast.LENGTH_SHORT).show();
+        });
+        if (MediaSniffer.isVimeoUrl(url)) MediaSniffer.resolveVimeoFromUrl(page.key, url, active.getTitle(), completed);
+        else if (MediaSniffer.isYouTubeUrl(url)) MediaSniffer.resolveYouTubeFromUrl(page.key, url, active.getTitle(), completed);
+        else extractAndGrabPageLinks(active);
     }
 
