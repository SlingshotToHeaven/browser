<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/ll_settings_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <!-- Header Row: Icon, Title, Subtitle, Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_settings_icon_tile"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_ai_spark"
                android:tint="#4A88F7"
                android:scaleType="centerInside"
                android:padding="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_settings_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agent Settings"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_settings_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Configure engine provider &amp; credentials"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_settings_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_close"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Header Hairline Separator -->
        <View
            android:id="@+id/v_settings_header_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp" />

        <!-- AI Engine Provider Label -->
        <TextView
            android:id="@+id/tv_provider_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI ENGINE PROVIDER"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <!-- Segmented Provider Tabs (Matching Chatbox Pill Style) -->
        <LinearLayout
            android:id="@+id/ll_provider_tabs"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_provider_antigravity"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Antigravity"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:background="@drawable/bg_agent_pill_selected"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tab_provider_termux"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="Termux"
                android:textSize="12sp"
                android:singleLine="true"
                android:background="@drawable/bg_agent_pill_unselected" />

            <TextView
                android:id="@+id/tab_provider_gemini"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="Gemini API"
                android:textSize="12sp"
                android:singleLine="true"
                android:background="@drawable/bg_agent_pill_unselected" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_provider_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="CloudCode OAuth engine with unmetered access."
            android:textSize="11sp" />

        <!-- CONTAINER 1: Antigravity Cloud OAuth Settings Card -->
        <LinearLayout
            android:id="@+id/layout_antigravity_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_ag_account_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Google Account: Not connected"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Account Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_ag_signin"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Connect Google Account"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_ag_signout"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Sign Out"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_ag_model_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="CLOUD MODEL"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <RadioGroup
                android:id="@+id/rg_ag_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_ag_flash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="Gemini 3.8 Flash (Low Latency)"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rb_ag_pro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="Gemini 2.5 Pro (Deep Reasoning)"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rb_ag_sonnet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="Claude 3.5 Sonnet (Coding &amp; Nuance)"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rb_ag_opus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="Claude Opus (Advanced Orchestration)"
                    android:textSize="12sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- CONTAINER 2: Termux Bridge Settings Card -->
        <LinearLayout
            android:id="@+id/layout_termux_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_termux_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Checking bridge connection..."
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_termux_endpoint_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="BRIDGE ENDPOINT URL"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <EditText
                android:id="@+id/et_termux_endpoint"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:hint="http://127.0.0.1:8080"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_open_termux"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Open Termux"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_ping_bridge"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Test Connection"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_termux_model_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="BRIDGE MODEL"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <RadioGroup
                android:id="@+id/rg_termux_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_termux_flash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="Gemini 3.8 Flash (Fast &amp; Autonomous)"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rb_termux_pro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="Gemini 2.5 Pro (Deep Reasoning)"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rb_termux_sonnet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="Claude 3.5 Sonnet (Coding &amp; Nuance)"
                    android:textSize="12sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- CONTAINER 3: Gemini Developer API Key Settings Card -->
        <LinearLayout
            android:id="@+id/layout_gemini_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_settings_key_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GEMINI API KEY"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <EditText
                android:id="@+id/et_gemini_api_key"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:hint="AIzaSy..."
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_settings_model_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="API MODEL"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <RadioGroup
                android:id="@+id/rg_ai_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_model_flash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="Gemini 3.8 Flash (Fast &amp; Multimodal)"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rb_model_pro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="Gemini 2.5 Pro (Complex Reasoning)"
                    android:textSize="12sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Footer Hairline Separator -->
        <View
            android:id="@+id/v_settings_footer_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="14dp" />

        <!-- Dialog Footer Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Cancel"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="Save Settings"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
