<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_quality_container"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:layout_marginBottom="8dp"
    android:background="?attr/bgQualityItemSelector"
    android:clickable="true"
    android:focusable="true">

    <RadioButton
        android:id="@+id/item_quality_radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:buttonTint="?attr/accentColor" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/item_quality_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1080p Full HD"
            android:textColor="?attr/textPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_quality_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MP4 Video • High Definition"
            android:textColor="?attr/textSecondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/item_quality_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="~45.2 MB"
        android:textColor="#00E5FF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/bg_size_pill"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp" />

</LinearLayout>
