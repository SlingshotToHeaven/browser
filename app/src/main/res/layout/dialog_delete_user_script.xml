<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/bgDialogSurface"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_trash"
            android:tint="#EF4444"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete Scriptlet"
                android:textColor="?attr/textPrimary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This action cannot be undone"
                android:textColor="?attr/textSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_delete_dialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="?attr/textSecondary"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- File info container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/bgInputBox"
        android:padding="12dp"
        android:layout_marginBottom="18dp">

        <TextView
            android:id="@+id/tv_delete_script_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="script_name.js"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Are you sure you want to permanently delete this user scriptlet from app storage?"
            android:textColor="?attr/textSecondary"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_cancel_delete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Cancel"
            android:textColor="?attr/textSecondary"
            android:textSize="12sp"
            android:background="?attr/borderHairline"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_confirm_delete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Delete"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:background="?attr/bgAccentButton"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

</LinearLayout>
