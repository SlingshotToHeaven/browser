<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/bgDialogSurface"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PAGE ZOOM AND SCALING"
        android:textColor="?attr/accentColor"
        android:textSize="12sp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.08" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adjust the default sizing and layout density of websites."
        android:textColor="?attr/textSecondary"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <RadioGroup
        android:id="@+id/dialog_radio_group_page_zoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp">

        <!-- 80% -->
        <RadioButton
            android:id="@+id/radio_zoom_80"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="80% (Small / High Density)\nMakes elements much smaller, showing maximum content"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            android:buttonTint="#00E5FF"
            android:lineSpacingExtra="2dp"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 85% -->
        <RadioButton
            android:id="@+id/radio_zoom_85"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="85% (Compact Phone Layout)\nBalanced compact sizing, fits more on large screens"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            android:buttonTint="#00E5FF"
            android:lineSpacingExtra="2dp"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 90% -->
        <RadioButton
            android:id="@+id/radio_zoom_90"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="90% (Slightly Compact)\nCrisp sizing, reduces oversized buttons and headers"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            android:buttonTint="#00E5FF"
            android:lineSpacingExtra="2dp"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 100% -->
        <RadioButton
            android:id="@+id/radio_zoom_100"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="100% (Standard Mobile Default)\nStandard mobile 1:1 scaling"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            android:buttonTint="#00E5FF"
            android:lineSpacingExtra="2dp"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 110% -->
        <RadioButton
            android:id="@+id/radio_zoom_110"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="110% (Comfortable)\nSlightly larger text and touch targets"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            android:buttonTint="#00E5FF"
            android:lineSpacingExtra="2dp"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 125% -->
        <RadioButton
            android:id="@+id/radio_zoom_125"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="125% (Large)\nEnlarged content for maximum readability"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            android:buttonTint="#00E5FF"
            android:lineSpacingExtra="2dp"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </RadioGroup>
</LinearLayout>