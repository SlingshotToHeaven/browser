<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/bgDialogSurface"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_bookmark"
            android:tint="#4CAF50" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Filters"
                android:textColor="?attr/textPrimary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_rules_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 rules active"
                android:textColor="?attr/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_my_filters"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#888888"
            android:scaleType="centerInside" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Syntax: domain.com##selector (Cosmetic) | ||host^ (Block) | @@||host^ (Whitelist)"
        android:textColor="#666666"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <!-- Code Editor Box -->
    <EditText
        android:id="@+id/edit_my_filters_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/bgDialogSurface"
        android:gravity="top|start"
        android:hint="! Enter custom filter rules, one per line..."
        android:textColor="?attr/textPrimary"
        android:textColorHint="#444444"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:padding="12dp"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:layout_marginBottom="14dp" />

    <!-- Actions Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_reset_filters"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Clear"
            android:textColor="#FF5252"
            android:background="?attr/surfaceCard"
            android:textSize="13sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_save_filters"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="2"
            android:text="Save &amp; Apply Changes"
            android:textColor="#000000"
            android:background="@drawable/bg_download_btn_accent"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
