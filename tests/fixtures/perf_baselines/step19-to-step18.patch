+    private static boolean selectVideo(String key, String videoId, boolean skipDuplicate) {
+        PageMedia page = key == null ? null : pages.get(key);
+        if (page == null) return false;
+        synchronized (page.items) {
+            if (videoId.equals(page.videoId)) return !skipDuplicate;
+            if (page.videoId != null) page.items.clear();
+            page.videoId = videoId;
+        }
+        return true;
