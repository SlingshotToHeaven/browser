<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_download_bg"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:padding="12dp">

    <CheckBox
        android:id="@+id/grabbed_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#00E5FF"
        android:layout_marginEnd="8dp" />

    <ImageView
        android:id="@+id/grabbed_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_link"
        android:tint="#80FFFFFF"
        android:scaleType="centerInside"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/grabbed_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="File Name"
            android:textColor="?attr/textPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/grabbed_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://example.com/file.zip"
            android:textColor="?attr/textSecondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/grabbed_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Archives"
                android:textColor="?attr/accentColor"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/grabbed_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#4CAF50"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/grabbed_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="?attr/textSecondary"
                android:textSize="10sp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
