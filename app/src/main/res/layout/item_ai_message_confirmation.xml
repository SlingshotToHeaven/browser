<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/ll_confirmation_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ai_confirmation_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_confirmation_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm Action"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#F87171" />

        <TextView
            android:id="@+id/tv_confirmation_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Details of items to be deleted or modified."
            android:textSize="13sp"
            android:textColor="#E2E8F0"
            android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_confirm_cancel"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_agent_cancel_btn"
                android:text="Cancel"
                android:textSize="12sp"
                android:textColor="#CBD5E1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <Button
                android:id="@+id/btn_confirm_execute"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_agent_confirm_btn"
                android:text="Confirm"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
