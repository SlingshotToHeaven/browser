<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/engine_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_search"
        android:tint="?attr/accentColor"
        android:scaleType="centerInside"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/engine_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Engine Name"
            android:textColor="?attr/textPrimary"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/engine_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Engine description"
            android:textColor="?attr/textSecondary"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/engine_category_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GENERAL"
        android:textColor="?attr/textSecondary"
        android:textSize="9.5sp"
        android:fontFamily="sans-serif-bold"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="?attr/bgPillThreadUnselected"
        android:layout_marginStart="8dp" />

</LinearLayout>
