<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/bgDialogSurface"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_shield"
            android:tint="#FFA000" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anti-Bot Verification"
                android:textColor="?attr/textPrimary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complete captcha below to continue download"
                android:textColor="?attr/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_captcha"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#888888"
            android:scaleType="centerInside" />
    </LinearLayout>

    <!-- Challenge WebView -->
    <FrameLayout
        android:id="@+id/captcha_webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000" />

    <!-- Action Button -->
    <Button
        android:id="@+id/btn_captcha_done"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Verification Done — Resume Download"
        android:textColor="#000000"
        android:background="@drawable/bg_download_btn_accent"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="12dp" />

</LinearLayout>
