+    public static void registerPageCandidate(String page, String url, String title) {
+        if (url == null) return;
+        String path;
+        try { path = new java.net.URI(url).getPath(); }
+        catch (java.net.URISyntaxException e) { return; }
+        if (path == null) return;
+        path = path.toLowerCase(Locale.US);
+        if (path.endsWith(".m3u8") || path.endsWith(".mpd")) {
+            registerMedia(page, url, title, "video", path.endsWith(".m3u8") ? "HLS" : "DASH", -1);
+        } else if (path.matches(".*\\.(mp3|m4a|flac|wav|ogg)")) {
+            registerMedia(page, url, title, "audio", "Audio", -1);
+        } else if (path.matches(".*\\.(mp4|m4v|webm|ogv)")) {
+            registerMedia(page, url, title, "video", "Auto", -1);
+        }
+    }
