<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/bgTabCard"
    android:padding="20dp">

    <!-- Header / Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/edit_dlg_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_bookmark"
            android:tint="?attr/accentColor"
            android:background="?attr/bgTabCardActive"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/edit_dlg_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Bookmark"
            android:textColor="?attr/textPrimary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-bold" />

        <!-- Quick Folder Indicator Chip in Header -->
        <LinearLayout
            android:id="@+id/edit_dlg_chip_folder"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/bgChipAction"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_bookmarks_folder"
                android:tint="#FFB300"
                android:scaleType="centerInside"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/edit_dlg_text_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bookmarks"
                android:textColor="?attr/textPrimary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="110dp"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/ic_arrow_down"
                android:tint="#7A8098"
                android:scaleType="centerInside"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/borderHairline"
        android:layout_marginBottom="12dp" />

    <!-- Preview Hero Section (Only for Bookmarks, hidden for Folders) -->
    <LinearLayout
        android:id="@+id/edit_dlg_preview_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_history_icon_tile"
        android:padding="8dp"
        android:layout_marginBottom="14dp">

        <!-- Frame sized to full available width of dialog -->
        <FrameLayout
            android:id="@+id/edit_dlg_preview_frame"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/bg_bookmark_card"
            android:padding="2dp">

            <ImageView
                android:id="@+id/edit_dlg_preview_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/edit_dlg_preview_fallback"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bookmark"
                android:tint="?attr/accentColor"
                android:scaleType="centerInside" />

            <!-- Reset / Remove Cover Action Pill on Preview (Top Left) -->
            <ImageView
                android:id="@+id/edit_dlg_btn_remove_preview"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:src="@drawable/ic_trash"
                android:tint="#FF5555"
                android:background="?attr/bgCircleButton"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <!-- Change Cover Action Button (Edit Icon in Top Right) -->
            <ImageView
                android:id="@+id/edit_dlg_btn_change_preview"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:src="@drawable/ic_edit"
                android:tint="?attr/accentColor"
                android:background="?attr/bgCircleButton"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

    </LinearLayout>

    <!-- Title Label & Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TITLE"
        android:textColor="#00E5FF"
        android:textSize="10sp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_history_search_pill"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/edit_dlg_input_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Bookmark title"
            android:textColorHint="#545870"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            android:singleLine="true" />

        <!-- Search button using current search engine -->
        <ImageView
            android:id="@+id/edit_dlg_search_title"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_search"
            android:tint="?attr/accentColor"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="2dp" />

        <ImageView
            android:id="@+id/edit_dlg_clear_title"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            android:tint="#7A8098"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- URL Label & Field (Hidden for Folders) -->
    <LinearLayout
        android:id="@+id/edit_dlg_url_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="URL"
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_history_search_pill"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:layout_marginBottom="14dp">

            <EditText
                android:id="@+id/edit_dlg_input_url"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="https://example.com"
                android:textColorHint="#545870"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp"
                android:singleLine="true" />

            <!-- Dedicated Copy Icon -->
            <ImageView
                android:id="@+id/edit_dlg_copy_url"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_copy"
                android:tint="#7A8098"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="2dp" />

            <ImageView
                android:id="@+id/edit_dlg_clear_url"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:tint="#7A8098"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Actions (Save & Cancel) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/edit_dlg_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="?attr/textSecondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/edit_dlg_btn_save"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Save"
            android:textColor="#000000"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/bg_history_icon_tile"
            android:backgroundTint="#00E5FF" />
    </LinearLayout>

</LinearLayout>
