<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/bgBookmarkCard"
    android:descendantFocusability="blocksDescendants"
    android:padding="5dp">

    <!-- Thumbnail Preview / Folder Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="160dp">

        <!-- 480p Screenshot Preview -->
        <ImageView
            android:id="@+id/card_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="?attr/surfaceCard"
            android:visibility="gone" />

        <!-- Fallback Graphic Container (Folder or Favicon Card) -->
        <LinearLayout
            android:id="@+id/card_fallback_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/surfaceCard">

            <ImageView
                android:id="@+id/card_icon_folder"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_bookmarks_folder"
                android:tint="#FFB300"
                android:scaleType="centerInside"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/card_favicon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/card_monogram"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:textColor="?attr/accentColor"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                android:text="B" />
        </LinearLayout>

        <!-- Selection Checkbox (Top Left of Card) -->
        <CheckBox
            android:id="@+id/card_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:buttonTint="?attr/accentColor"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone" />

        <!-- More Button (Top Right of Card) -->
        <ImageView
            android:id="@+id/card_btn_more"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="2dp"
            android:src="@drawable/ic_more_vert"
            android:tint="?attr/iconTintPrimary"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="false"
            android:padding="5dp" />

    </FrameLayout>

    <!-- Card Footer: Title & Host/Count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="5dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/textPrimary"
            android:textSize="12.5sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/card_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/textSecondary"
            android:textSize="10.5sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />

    </LinearLayout>

</LinearLayout>
