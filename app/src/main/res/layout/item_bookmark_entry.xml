<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:descendantFocusability="blocksDescendants"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Leading Tile: Favicon / Monogram / Folder Icon / Checkbox -->
    <FrameLayout
        android:id="@+id/bookmark_leading_container"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_history_icon_tile">

        <ImageView
            android:id="@+id/bookmark_icon_folder"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_bookmarks_folder"
            android:tint="#FFB300"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/bookmark_favicon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/bookmark_monogram"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="?attr/accentColor"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold"
            android:text="B" />

        <CheckBox
            android:id="@+id/bookmark_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:buttonTint="?attr/accentColor"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Content: Title & Combined Subtitle (Host/Url or Folder Item Count + Date) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bookmark_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/textPrimary"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="1dp">

            <TextView
                android:id="@+id/bookmark_url"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/textSecondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/bookmark_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/textSecondary"
                android:textSize="10sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick More / Options Action -->
    <ImageView
        android:id="@+id/bookmark_btn_more"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_more_vert"
        android:tint="?attr/iconTintSecondary"
        android:scaleType="centerInside"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:padding="6dp" />

</LinearLayout>
