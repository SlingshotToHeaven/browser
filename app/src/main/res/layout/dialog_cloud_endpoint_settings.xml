<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/bgDialogSurface"
    android:padding="20dp">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_cloud"
            android:tint="?attr/accentColor"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cloudflare Worker Endpoint"
            android:textColor="?attr/textPrimary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/btn_close_endpoint_settings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="?attr/textSecondary"
            android:contentDescription="Close" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the base HTTPS URL of your deployed Cloudflare Worker."
        android:textColor="?attr/textSecondary"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <!-- Clean Input Box with background -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/bgInputBox"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/edit_endpoint_url"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:hint="https://your-worker.workers.dev"
            android:textColor="?attr/textPrimary"
            android:textColorHint="?attr/textMuted"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:inputType="textUri"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_cancel_endpoint"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Cancel"
            android:textColor="?attr/textSecondary"
            android:textSize="12sp"
            android:background="?attr/borderHairline"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_save_endpoint"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Save Endpoint"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:background="?attr/bgAccentButton"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>
</LinearLayout>
