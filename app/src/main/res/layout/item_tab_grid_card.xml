<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_tab_root"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:orientation="vertical"
    android:layout_margin="6dp"
    android:background="?attr/bgTabCard"
    android:elevation="4dp">

    <!-- Card Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/surfaceToolbar"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/tab_icon_incognito"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_incognito"
            android:tint="?attr/accentColor"
            android:scaleType="centerInside"
            android:visibility="gone"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tab_card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Page Title"
            android:textColor="?attr/textPrimary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/tab_card_btn_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:tint="?attr/iconTintSecondary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="6dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/borderHairline" />

    <!-- Site Preview Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/surfaceCard">

        <ImageView
            android:id="@+id/tab_card_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Placeholder when no preview exists -->
        <LinearLayout
            android:id="@+id/tab_card_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_search"
                android:tint="?attr/iconTintSecondary"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/tab_card_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="duckduckgo.com"
                android:textColor="?attr/textSecondary"
                android:textSize="10sp"
                android:layout_marginTop="6dp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Active Border Overlay Indicator -->
        <View
            android:id="@+id/tab_active_indicator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/bgTabCardActive"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
