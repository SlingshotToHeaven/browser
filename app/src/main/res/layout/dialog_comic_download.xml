<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/bgDialogSurface"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_comic"
            android:tint="?attr/accentColor" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comic / CBR Downloader"
                android:textColor="?attr/textPrimary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_comic_page_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sequential image stream detected"
                android:textColor="?attr/textSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_comic_dialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#888888"
            android:scaleType="centerInside" />
    </LinearLayout>

    <!-- Chapter Title Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Archive Title"
        android:textColor="?attr/textSecondary"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/edit_comic_title"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="?attr/surfaceCard"
        android:textColor="?attr/textPrimary"
        android:textSize="14sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:layout_marginBottom="14dp" />

    <!-- Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/surfaceCard"
        android:padding="12dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Detected Pages"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_comic_page_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 pages"
                android:textColor="?attr/accentColor"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Resolution"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full-Res Extracted"
                android:textColor="#4CAF50"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Format Chooser (CBR / CBZ) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Archive Format"
        android:textColor="?attr/textSecondary"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <RadioGroup
        android:id="@+id/rg_comic_format"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rb_format_cbr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=".CBR (Comic Book)"
            android:textColor="?attr/textPrimary"
            android:checked="true"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_format_cbz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=".CBZ (ZIP Archive)"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- Progress Container (Shown while downloading) -->
    <LinearLayout
        android:id="@+id/ll_comic_download_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_comic_download_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Downloading page 1 of ..."
            android:textColor="?attr/textSecondary"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <ProgressBar
            android:id="@+id/pb_comic_download"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progress="0"
            android:max="100" />
    </LinearLayout>

    <!-- Download Action Button -->
    <Button
        android:id="@+id/btn_start_comic_download"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Download .CBR Archive"
        android:textColor="#000000"
        android:background="@drawable/bg_download_btn_accent"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
