<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:id="@+id/card_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/bgCardDownload"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Top info row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- File Type Icon / Selection Checkbox Container -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp">

                <FrameLayout
                    android:id="@+id/card_icon_container"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/bgInputBox">

                    <ImageView
                        android:id="@+id/card_icon_file"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_file_generic"
                        android:scaleType="centerInside" />
                </FrameLayout>

                <CheckBox
                    android:id="@+id/card_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:buttonTint="?attr/accentColor"
                    android:padding="0dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Filename & Status Badge -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/card_text_filename"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Filename.zip"
                    android:textColor="?attr/textPrimary"
                    android:textSize="13.5sp"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingExtra="1.5dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/card_text_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RUNNING"
                        android:textColor="#BB86FC"
                        android:textSize="9.5sp"
                        android:fontFamily="sans-serif-bold"
                        android:background="@drawable/bg_badge_running"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action buttons row -->
            <LinearLayout
                android:id="@+id/card_actions_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/card_btn_info"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_info"
                    android:tint="?attr/iconTintSecondary"
                    android:scaleType="centerInside"
                    android:background="?attr/bgBtnSecondary"
                    android:padding="7dp"
                    android:layout_marginEnd="6dp" />

                <ImageView
                    android:id="@+id/card_btn_link"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_link"
                    android:tint="?attr/iconTintSecondary"
                    android:scaleType="centerInside"
                    android:background="?attr/bgBtnSecondary"
                    android:padding="7dp"
                    android:layout_marginEnd="6dp" />

                <ImageView
                    android:id="@+id/card_btn_pause_resume"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_pause"
                    android:tint="#BB86FC"
                    android:scaleType="centerInside"
                    android:background="?attr/bgBtnSecondary"
                    android:padding="7dp"
                    android:layout_marginEnd="6dp" />

                <ImageView
                    android:id="@+id/card_btn_delete"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_delete"
                    android:tint="#FF5252"
                    android:scaleType="centerInside"
                    android:background="?attr/bgBtnSecondary"
                    android:padding="7dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/card_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="7dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/custom_download_progress" />

        <!-- Subtitle (size, speed, inline actions, eta) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/card_text_stats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="14.2 MB / 45.0 MB (31%) • 2.4 MB/s"
                android:textColor="?attr/textSecondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/card_btn_checksum"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="SHA-256"
                android:textSize="10sp"
                android:textColor="?attr/accentColor"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="?attr/bgPillThreadUnselected"
                android:layout_marginStart="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/card_btn_extract"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="Extract"
                android:textSize="10sp"
                android:textColor="#FFB74D"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="?attr/bgPillThreadUnselected"
                android:layout_marginStart="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/card_text_eta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ETA: 12s"
                android:textColor="?attr/accentColor"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
