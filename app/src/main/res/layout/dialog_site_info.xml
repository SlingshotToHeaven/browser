<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/bgDialogSurface"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/site_info_icon_security"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_shield"
            android:tint="#4CAF50"
            android:background="#1A4CAF50"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/site_info_text_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connection is Secure"
                android:textColor="?attr/textPrimary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/site_info_text_host"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="example.com"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/borderHairline" />

    <!-- Storage and Cache Actions -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SITE STORAGE &amp; COOKIES"
        android:textColor="?attr/accentColor"
        android:textSize="11sp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.05"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/surfaceCard"
        android:padding="12dp"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/site_info_data_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/textSecondary"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/borderHairline"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/site_info_btn_clear_browser"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Review all-sites cleanup"
            android:textColor="#FF5252"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <!-- Permissions Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PERMISSIONS"
        android:textColor="?attr/accentColor"
        android:textSize="11sp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.05"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/surfaceCard"
        android:padding="12dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Camera &amp; Microphone"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/site_perm_media"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/accentColor" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Location / Geolocation"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/site_perm_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/accentColor" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/site_info_btn_done"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Done"
        android:textColor="?attr/textPrimary"
        android:background="?attr/borderHairline"
        android:layout_marginTop="16dp" />

</LinearLayout>
