<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_agent_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Scrim / Tap outside to dismiss -->
    <View
        android:id="@+id/v_scrim_dismiss"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />

    <!-- Sheet Card Container -->
    <LinearLayout
        android:id="@+id/ll_agent_sheet_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <!-- Top Drag Handle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <View
                android:id="@+id/v_drag_handle"
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_agent_drag_handle" />
        </LinearLayout>

        <!-- Header Bar: Title, Mode Chips, Settings & Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <!-- Brand: Spark Icon + "Agent" Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_ai_spark"
                    android:tint="#4A88F7"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/tv_agent_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Agent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Compact Mode Selector Chips (Centered) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tab_mode_structured"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Structured"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:background="@drawable/bg_agent_pill_selected"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tab_mode_raw"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Raw"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Actions Container (Right-aligned, strictly contained) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_ai_sheet_new_chat"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_add"
                    android:tint="#94A3B8"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:contentDescription="New Chat" />

                <ImageButton
                    android:id="@+id/btn_ai_sheet_history"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_history"
                    android:tint="#94A3B8"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:contentDescription="Chat History" />

                <ImageButton
                    android:id="@+id/btn_ai_sheet_settings"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_settings"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:contentDescription="Settings" />

                <ImageButton
                    android:id="@+id/btn_ai_sheet_stop"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_stop"
                    android:tint="#EF4444"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:visibility="gone"
                    android:contentDescription="Stop and Exit Agent" />

                <ImageButton
                    android:id="@+id/btn_ai_sheet_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_close"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:contentDescription="Close" />
            </LinearLayout>
        </LinearLayout>

        <!-- Subtle Hairline Divider -->
        <View
            android:id="@+id/v_header_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="2dp" />

        <!-- Raw Mode Banner / Placeholder View -->
        <LinearLayout
            android:id="@+id/ll_raw_mode_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Raw Mode (Preview)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#F59E0B" />

            <TextView
                android:id="@+id/tv_raw_mode_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Raw direct script orchestration is in preview. Structured Mode is currently active."
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/ll_agent_empty_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_ai_spark"
                android:tint="#4A88F7"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/tv_empty_state_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Browse smarter with Agent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_empty_state_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Inspect, automate, or summarize the active page"
                android:textSize="12sp" />

            <!-- Suggestion Chips Container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/chip_suggest_summarize"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Summarize this page"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_suggest_extract"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Extract main content &amp; links"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_suggest_inspect"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Check page security &amp; trackers"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Message Thread Recycler (flexibly fills vertical space) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_ai_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <!-- Bottom Elevated Input Area -->
        <LinearLayout
            android:id="@+id/ll_input_area_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <!-- Pending Attachment Preview Bar (shown when screenshot captured) -->
            <LinearLayout
                android:id="@+id/ll_pending_attachment_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"
                android:paddingStart="6dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_agent_pending_attachment"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_pending_attachment_thumb"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_agent_thumb_round"
                    android:contentDescription="Attached Screenshot" />

                <TextView
                    android:id="@+id/tv_pending_attachment_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Screenshot attached"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:fontFamily="sans-serif-medium" />

                <ImageButton
                    android:id="@+id/btn_remove_pending_attachment"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_close"
                    android:tint="#94A3B8"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:contentDescription="Remove Screenshot" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_input_bar_pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <!-- Vision Attachment Button -->
                <ImageButton
                    android:id="@+id/btn_ai_attach_vision"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_camera_placeholder"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:contentDescription="Attach Screenshot" />

                <!-- Prompt Input -->
                <EditText
                    android:id="@+id/et_ai_prompt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@null"
                    android:hint="Ask Agent to inspect, clean, or navigate..."
                    android:textSize="14sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:maxLines="4" />

                <!-- Send Button -->
                <ImageButton
                    android:id="@+id/btn_ai_send"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_arrow_forward"
                    android:background="@drawable/bg_agent_pill_selected"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside"
                    android:contentDescription="Send Prompt" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
