<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/history_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:descendantFocusability="blocksDescendants"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Leading Avatar / Checkbox Tile Container -->
    <FrameLayout
        android:id="@+id/history_leading_container"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="10dp"
        android:background="?attr/bgHistoryIconTile">

        <ImageView
            android:id="@+id/history_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_history"
            android:tint="#00E5FF"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/history_favicon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/history_monogram"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="?attr/accentColor"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold"
            android:text="W" />

        <CheckBox
            android:id="@+id/history_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:buttonTint="#00E5FF"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Content: Title & Combined Subtitle (Host/Url + Date) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/history_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/textPrimary"
                android:textSize="13.5sp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/history_badge_repeat"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:background="?attr/bgHistoryCountPill"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="3 visits"
                android:textColor="?attr/accentColor"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="1dp">

            <TextView
                android:id="@+id/history_url"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/textSecondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/history_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/textSecondary"
                android:textSize="10sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Delete Entry Action -->
    <ImageView
        android:id="@+id/history_btn_delete"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_close"
        android:tint="#44465E"
        android:scaleType="centerInside"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:padding="7dp" />

</LinearLayout>
