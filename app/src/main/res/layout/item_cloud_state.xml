<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/borderHairline"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_state_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Block Popups on Streaming Sites"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_state_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 mins ago"
            android:textColor="?attr/textSecondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_state_item_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="By Community Contributor | 2 files modified"
            android:textColor="?attr/textSecondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_state_item_apply"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Pull / Apply"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:background="?attr/bgAccentButton"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>
</LinearLayout>
