+    public static boolean isVimeoUrl(String url) {
+        if (isEmpty(url)) return false;
+        return VIMEO_URL_PATTERN.matcher(url).find();
+    }
+
+    public static boolean isYouTubeUrl(String url) {
+        if (isEmpty(url)) return false;
+        return YOUTUBE_URL_PATTERN.matcher(url).find();
+    }
