<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/bgDialogSurface"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_folder"
            android:tint="?attr/accentColor"
            android:background="@drawable/bg_pill_thread_selected"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Download Folder"
                android:textColor="?attr/textPrimary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/picker_text_current_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="/storage/emulated/0/Download"
                android:textColor="?attr/accentColor"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/picker_btn_new_folder"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_add"
            android:tint="#BB86FC"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="6dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/borderHairline" />

    <!-- Subdirectory List -->
    <ListView
        android:id="@+id/picker_list_folders"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:divider="?attr/borderHairline"
        android:dividerHeight="1dp"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:background="#0C0C12"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/borderHairline" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/picker_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:background="?attr/bgBtnSecondary"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/picker_btn_select"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.3"
            android:text="Select This Folder"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/bg_pill_thread_selected"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
