<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/bgDialogSurface"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_cloud"
                android:tint="?attr/accentColor"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_commit_dialog_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Commit AdBlock State"
                    android:textColor="?attr/textPrimary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_commit_dialog_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 files modified from baseline"
                    android:textColor="?attr/textSecondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_close_commit_dialog"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:tint="?attr/textSecondary"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Changes Being Committed Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Changes Being Committed"
                android:textColor="?attr/textPrimary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_commit_diff_stats_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calculating..."
                android:textColor="?attr/textSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Diff Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/bgInputBox"
            android:padding="10dp"
            android:layout_marginBottom="14dp">

            <ScrollView
                android:id="@+id/scroll_commit_diff_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/ll_commit_diff_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_commit_diff_loading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calculating modifications..."
                        android:textColor="?attr/textMuted"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter a short description summarizing what rules or scriptlets were added or fixed:"
            android:textColor="?attr/textSecondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <!-- Styled Input Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/bgInputBox"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/edit_commit_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:gravity="top|start"
                android:background="@android:color/transparent"
                android:hint="e.g. Blocked popup redirects on streaming site and fixed blank whitespace"
                android:textColor="?attr/textPrimary"
                android:textColorHint="?attr/textMuted"
                android:textSize="13sp"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="3" />
        </LinearLayout>

        <!-- Bottom Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_cancel_commit"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Cancel"
                android:textColor="?attr/textSecondary"
                android:textSize="12sp"
                android:background="?attr/borderHairline"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_submit_commit"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Commit &amp; Upload"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="?attr/bgAccentButton"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
