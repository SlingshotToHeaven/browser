<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/surfaceRoot">

    <!-- Top Toolbar -->
    <LinearLayout
        android:id="@+id/grabber_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="?attr/surfaceToolbar">

        <ImageView
            android:id="@+id/grabber_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="?attr/iconTintPrimary"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Link Grabber"
                android:textColor="?attr/textPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/grabber_tv_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 links discovered"
                android:textColor="?attr/textSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/grabber_btn_verify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verify"
            android:textColor="?attr/accentColor"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/grabber_btn_toggle_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select All"
            android:textColor="?attr/accentColor"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Search filter bar -->
    <LinearLayout
        android:id="@+id/grabber_search_container"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@id/grabber_toolbar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/bgInputBox"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            android:tint="?attr/iconTintSecondary"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/grabber_edit_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Filter links by name or URL..."
            android:textColor="?attr/textPrimary"
            android:textColorHint="?attr/textMuted"
            android:textSize="13sp"
            android:background="@null"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/grabber_btn_clear_search"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:src="@drawable/ic_delete"
            android:tint="?attr/iconTintSecondary"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Category filter pills -->
    <HorizontalScrollView
        android:id="@+id/grabber_pills_scroll"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/grabber_search_container"
        android:background="?attr/surfaceRoot"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/grabber_pill_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="All"
                android:textSize="12sp"
                android:textColor="?attr/textPrimary"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="?attr/bgFilterPillSelected"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/grabber_pill_archives"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Archives"
                android:textSize="12sp"
                android:textColor="?attr/textSecondary"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="?attr/bgFilterPillUnselected"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/grabber_pill_videos"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Videos"
                android:textSize="12sp"
                android:textColor="?attr/textSecondary"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="?attr/bgFilterPillUnselected"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/grabber_pill_images"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Images"
                android:textSize="12sp"
                android:textColor="?attr/textSecondary"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="?attr/bgFilterPillUnselected"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/grabber_pill_docs"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Documents"
                android:textSize="12sp"
                android:textColor="?attr/textSecondary"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="?attr/bgFilterPillUnselected"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/grabber_pill_audio"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Audio"
                android:textSize="12sp"
                android:textColor="?attr/textSecondary"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="?attr/bgFilterPillUnselected"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/grabber_pill_other"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Links"
                android:textSize="12sp"
                android:textColor="?attr/textSecondary"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="?attr/bgFilterPillUnselected" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/grabber_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/surfaceToolbar">

        <TextView
            android:id="@+id/grabber_tv_selected_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Selected: 0 links"
            android:textColor="?attr/textPrimary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/grabber_btn_download"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Download Selected"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="#00E5FF"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>

    <!-- Links List -->
    <ListView
        android:id="@+id/grabber_list_links"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/grabber_pills_scroll"
        android:layout_above="@id/grabber_bottom_bar"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/grabber_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No links found matching criteria"
        android:textColor="#60FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

</RelativeLayout>
